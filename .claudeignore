# .claudeignore — files Claude Code should skip when reading the codebase.
# Goal: keep build artifacts, dependencies, large binaries, and lockfiles out of the context window.
# Add patterns specific to this project at the bottom.

# ── Dart / Flutter build outputs ────────────────────────────────────────────
.dart_tool/                  # Dart SDK build cache (regenerated by `flutter pub get`)
build/                       # Top-level Flutter build output
.flutter-plugins             # Auto-generated plugin registration
.flutter-plugins-dependencies # Auto-generated plugin dep map
.packages                    # Legacy package config (auto-generated)

# ── Lockfiles (large, stable, low information density) ─────────────────────
pubspec.lock                 # Pinned versions — read pubspec.yaml instead
ios/Podfile.lock             # CocoaPods lockfile
android/.gradle/             # Gradle cache + wrapper internals

# ── iOS / Xcode artifacts ──────────────────────────────────────────────────
ios/Pods/                    # CocoaPods install (regenerated by `pod install`)
ios/.symlinks/               # Symlinks to Flutter framework (auto-generated)
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Runner.xcworkspace/xcuserdata/
ios/Runner.xcodeproj/xcuserdata/
ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/
DerivedData/

# ── Android artifacts ──────────────────────────────────────────────────────
android/build/               # Project-level build output
android/app/build/           # Module-level build output
android/captures/            # Profiling captures
android/.cxx/                # Native build cache
android/local.properties     # Local SDK paths (machine-specific)
android/key.properties       # Signing config (must NEVER be committed)
android/*.keystore           # Keystore files (must NEVER be committed)
android/*.jks                # Keystore files (must NEVER be committed)

# ── Web / Desktop build outputs (mostly unmodified scaffolds in this repo) ─
web/build/
linux/build/
macos/build/
macos/Pods/
macos/Flutter/ephemeral/
windows/build/

# ── Test coverage output ────────────────────────────────────────────────────
coverage/
.coverage/
test/.test_coverage.dart

# ── IDE / OS metadata ───────────────────────────────────────────────────────
.idea/                       # IntelliJ / Android Studio settings
*.iml                        # IntelliJ module files
.vscode/settings.json        # VS Code per-workspace overrides
.DS_Store                    # macOS Finder metadata
Thumbs.db                    # Windows Explorer thumbnails
*.swp                        # vim swap files
*.swo

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/
flutter_*.png                # Crash screenshots dumped by `flutter run`

# ── Binary assets (heavy, low signal — keep paths visible via pubspec) ─────
assets/fonts/*.ttf
assets/fonts/*.otf
assets/images/*.png
assets/images/*.jpg
assets/images/*.jpeg
assets/images/*.webp
assets/logo/*.png
assets/logo/*.jpg

# ── Generated docs / explorations (re-derive on demand) ─────────────────────
docs/explorations/           # Per-module /explore output — re-run if needed

# ── Project-specific ───────────────────────────────────────────────────────
# (none yet — add patterns here as the project grows)
