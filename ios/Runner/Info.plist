<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- 🔐 Permissions (Crash-safe & App Store friendly wording) -->
    <key>NSCameraUsageDescription</key>
    <string>We use the camera to capture documents for KYC verification.</string>

    <key>NSMicrophoneUsageDescription</key>
    <string>Microphone access is required for recording videos.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>We need access to your photo library to upload documents.</string>

    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>We need permission to save images to your photo library.</string>

    <!-- (Optional - future safe for file picking) -->
    <key>NSDocumentsFolderUsageDescription</key>
    <string>We need access to files to upload documents.</string>

    <!-- 📱 App Info -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>

    <key>CFBundleDisplayName</key>
    <string>Betrade</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>betrade</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>

    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- 🚀 Launch -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!-- 📲 Orientation (Safe for Camera apps) -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- ⚡ Performance -->
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- 🔒 Export Compliance — set to false because the app uses only
         standard HTTPS / TLS, no custom cryptography. Avoids the manual
         "uses non-exempt encryption?" prompt on every TestFlight upload.
         If you ever add custom crypto (e.g. end-to-end encrypted chat),
         flip to <true/> and obtain an export compliance code. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- 🛍 App Store category. Finance is the closest fit for a
         prediction-markets app; change to .productivity or .lifestyle
         if review feedback suggests otherwise. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.finance</string>

</dict>
</plist>